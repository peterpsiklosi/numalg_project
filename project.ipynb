    "def update_leapfrog(ri, vi, a):\n",
    "    rf = np.empty_like(ri)\n",
    "    vf = np.empty_like(vi)\n",
    "    vf = vi + a\n",
    "    rf = ri + vf\n",
    "    return rf, vf"
   ]
